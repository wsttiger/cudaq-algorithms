[build-system]
requires = ["setuptools>=77", "setuptools-scm"]
build-backend = "setuptools.build_meta"

[project]
name = "cudaq-algorithms-cu13"
dynamic = ["version"]
description = "Reusable quantum algorithm primitives built on CUDA-Q"
authors = [{name = "NVIDIA Corporation & Affiliates"}]
maintainers = [{name = "NVIDIA Corporation & Affiliates"}]
requires-python = ">=3.11"
readme = "README.md"
license = "Apache-2.0"
dependencies = [
  # CUDA-Q runtime (cu13). Ships wheels for Linux and macOS (Apple
  # Silicon); Windows has no CUDA-Q wheel, so it resolves without the
  # runtime (classical modules work; circuit modules raise at point of use).
  "cuda-quantum-cu13 == 0.14.*; sys_platform == 'linux'",
  "cuda-quantum-cu13 == 0.14.*; sys_platform == 'darwin'",
  "numpy",
  "scipy",
  # Phase-factor generation for the QSVT examples (pure Python, on PyPI).
  "qsppack >= 0.3.10",
]

[tool.setuptools]
package-dir = {"" = "python"}

[tool.setuptools.packages.find]
where = ["python"]
include = ["cudaq_algorithms*"]

[tool.setuptools_scm]
